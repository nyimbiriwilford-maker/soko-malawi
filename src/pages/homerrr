                                  📍 {item?.city || 'Malawi'} · {timeAgo(item?.created_at)}
                                </div>
                              </div>
                              <button
                                onClick={e => { e.stopPropagation(); navigate('/listing/' + item?.id) }}
                                style={{
                                  flexShrink: 0,
                                  background: `linear-gradient(135deg,${T.green},#0a7a44)`,
